---
import Base from '../../layouts/Base.astro';
import CardRealisation from '../../components/CardRealisation.astro';
import { getCollection } from 'astro:content';
import { COMPETENCES } from '../../content.config';
const realisations = (await getCollection('realisations')).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base title="Réalisations">
  <section class="section">
    <p class="label">Page 4</p>
    <h1>Réalisations</h1>

    <div class="panel" style="margin:var(--sp-6) 0" id="filtres">
      <p class="label">Filtrer par compétence</p>
      <div class="chips" role="group" aria-label="Compétence E5">
        <button class="chip" type="button" data-filter="comp" data-value="" aria-pressed="true">Toutes</button>
        {COMPETENCES.map(c => <button class="chip" type="button" data-filter="comp" data-value={c} aria-pressed="false">{c}</button>)}
      </div>
      <p class="label" style="margin-top:var(--sp-4)">Filtrer par contexte</p>
      <div class="chips" role="group" aria-label="Contexte">
        <button class="chip" type="button" data-filter="ctx" data-value="" aria-pressed="true">Tous</button>
        <button class="chip" type="button" data-filter="ctx" data-value="pro" aria-pressed="false">Professionnel</button>
        <button class="chip" type="button" data-filter="ctx" data-value="perso" aria-pressed="false">Personnel</button>
      </div>
      <p class="small" style="margin-top:var(--sp-3)" aria-live="polite"><span data-count>{realisations.length}</span> réalisation(s) affichée(s) · <a href="/realisations" data-reset>réinitialiser</a></p>
    </div>

    <div class="grid grid--3" id="liste" style="position:relative">
      {realisations.map((r, i) => <CardRealisation entry={r} index={i} />)}
    </div>
    <p class="small" id="vide" hidden style="margin-top:var(--sp-4)">Aucune réalisation ne correspond à ces filtres.</p>
  </section>

  <script>
    import gsap from 'gsap';
    import { Flip } from 'gsap/Flip';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(Flip, ScrollTrigger);
    // Filtres cumulables. L'état vit dans l'URL (?comp=C2&ctx=pro) : partageable, bouton retour fonctionnel,
    // et la page Compétences peut deep-linker directement.
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('#liste .card')];
    const count = document.querySelector<HTMLElement>('[data-count]');
    const vide = document.getElementById('vide');
    const state = { comp: '', ctx: '' };

    function apply(push = true, anim = true) {
      // Transition animée (Flip) uniquement si les animations sont autorisées (html.gsap posé par motion.ts)
      const animate = anim && document.documentElement.classList.contains('gsap');
      if (animate) {
        // 1) un Flip encore en cours (clics rapprochés) est terminé net avant d'en lancer un autre
        Flip.killFlipsOf(cards, true);
        // 2) le reveal au défilement ne doit plus jamais toucher les cartes une fois qu'on filtre
        ScrollTrigger.getAll().forEach(t => { if (cards.includes(t.trigger as HTMLElement)) t.kill(); });
      }
      const before = animate ? Flip.getState(cards) : null;
      let n = 0;
      for (const c of cards) {
        const okComp = !state.comp || (c.dataset.comp ?? '').split(' ').includes(state.comp);
        const okCtx = !state.ctx || c.dataset.ctx === state.ctx;
        const show = okComp && okCtx;
        c.classList.toggle('is-hidden', !show); if (show) n++;
      }
      if (before) {
        // Toute carte affichée est forcée visible : le reveal initial (autoAlpha 0 / visibility hidden) peut
        // être encore en attente, et Flip ne détecte l'entrée que si l'élément est réellement visible « après ».
        const shown = cards.filter(c => !c.classList.contains('is-hidden'));
        // seules les propriétés du reveal sont tuées : les tweens persistants du tilt (quickTo) restent intacts
        gsap.killTweensOf(shown, 'autoAlpha,opacity,visibility,y'); gsap.set(shown, { autoAlpha: 1, y: 0 });
        document.documentElement.classList.add('flipping');
        Flip.from(before, {
          // absoluteOnLeave : seules les cartes sortantes passent en absolu ; les autres restent dans le flux
          // (sinon la grille s'effondre à 0 px pendant l'animation et tout saute à la fin)
          duration: 0.55, ease: 'power2.inOut', stagger: 0.03, absoluteOnLeave: true, nested: true,
          onEnter: (els) => gsap.fromTo(els, { autoAlpha: 0, scale: 0.92, y: 0 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'power2.out', stagger: 0.04 }),
          onLeave: (els) => gsap.to(els, { autoAlpha: 0, scale: 0.92, duration: 0.3, ease: 'power2.in' }),
          // à la fin : transform remis à plat (plus aucun résidu de déplacement possible), perspective 3D rétablie
          onComplete: () => {
            // remise à zéro explicite (pas de clearProps : il casserait le cache des tweens de tilt)
            gsap.set(shown, { x: 0, y: 0, scale: 1, rotationX: 0, rotationY: 0, transformPerspective: 900, transformOrigin: 'center' });
            document.documentElement.classList.remove('flipping');
          },
        });
      }
      if (count) count.textContent = String(n);
      if (vide) vide.hidden = n > 0;
      for (const ch of chips) {
        const k = ch.dataset.filter as 'comp' | 'ctx';
        ch.setAttribute('aria-pressed', String(state[k] === (ch.dataset.value ?? '')));
      }
      if (push) {
        const p = new URLSearchParams();
        if (state.comp) p.set('comp', state.comp);
        if (state.ctx) p.set('ctx', state.ctx);
        const q = p.toString();
        history.pushState(null, '', q ? `?${q}` : location.pathname);
      }
    }
    function fromUrl(anim = false) {
      const p = new URLSearchParams(location.search);
      state.comp = p.get('comp') ?? ''; state.ctx = p.get('ctx') ?? '';
      apply(false, anim);
    }
    for (const ch of chips) ch.addEventListener('click', () => {
      const k = ch.dataset.filter as 'comp' | 'ctx';
      state[k] = ch.dataset.value ?? ''; apply();
    });
    document.querySelector('[data-reset]')?.addEventListener('click', e => { e.preventDefault(); state.comp = ''; state.ctx = ''; apply(); });
    window.addEventListener('popstate', () => fromUrl(true));
    fromUrl(); // état initial (deep-link) sans animation
  </script>
</Base>
