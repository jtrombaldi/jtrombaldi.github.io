---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { getCollection, render } from 'astro:content';
const fiches = (await getCollection('veille')).sort((a, b) => a.data.ordre - b.data.ordre);
const rendered = await Promise.all(fiches.map(async f => ({ f, Content: (await render(f)).Content })));
const sources = ['ANSSI', 'IT-Connect', 'BleepingComputer', 'Next INpact', 'The Register', 'Ars Technica'];
const themes = ['Cybersécurité', 'Infrastructure Linux', 'Réseau', 'Failles CVE', 'Virtualisation', 'Protocoles'];
---
<Base title="Veille technologique">
  <section class="section">
    <p class="label">Page 5 · compétence C6</p>
    <h1>Veille technologique</h1>
    <div class="grid grid--3" style="margin-top:var(--sp-6)">
      <div class="panel">
        <p class="label">Méthode</p>
        <p class="small">Agrégateur <strong style="color:var(--fg)">Feedly</strong> avec un compte dédié (conservé après la formation), dossier « Veille IT », flux RSS. Fréquence et organisation : <span class="todo">à préciser</span>.</p>
      </div>
      <div class="panel">
        <p class="label">Sources configurées</p>
        <div class="tags">{sources.map(s => <span class="tag">{s}</span>)}</div>
      </div>
      <div class="panel">
        <p class="label">Thèmes surveillés</p>
        <div class="tags">{themes.map(t => <span class="tag">{t}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="label">Fiches de veille personnelles</p>
    <h2>Articles analysés</h2>
    <p class="small" style="margin-bottom:var(--sp-4)">4 à 6 fiches. Chacune : titre, source, date, résumé — et surtout l'<strong style="color:var(--fg)">apport personnel</strong>.</p>
    {rendered.length === 0 && (
      <Placeholder titre="Fiches à rédiger">Aucune fiche pour l'instant. Elles vivent dans <code>src/content/veille/</code> — une fiche = un fichier.</Placeholder>
    )}
    <div class="grid grid--2">
      {rendered.map(({ f, Content }) => (
        <article class="card">
          <p class="small" style="margin-bottom:var(--sp-1)">{f.data.source} · {f.data.date}</p>
          <h3>{f.data.url ? <a href={f.data.url} rel="noopener">{f.data.titre}</a> : f.data.titre}</h3>
          <p>{f.data.resume}</p>
          <div class="panel panel--soft prose" style="padding:var(--sp-3) var(--sp-4)">
            <p class="label">★ Apport personnel</p>
            <Content />
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
