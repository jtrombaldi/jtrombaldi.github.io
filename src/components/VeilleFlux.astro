---
// Visualisation sobre de la méthode de veille : sources → agrégateur → fiches (brief §5, §7).
const boxes = [
  { x: 10,  w: 170, l1: 'SOURCES', l2: 'ANSSI · IT-Connect · …' },
  { x: 300, w: 200, l1: 'FEEDLY', l2: 'dossier « Veille IT »', accent: true },
  { x: 620, w: 170, l1: 'FICHES', l2: 'résumé + apport perso' },
];
---
<svg class="flux" viewBox="0 0 800 70" role="img" aria-label="Méthode de veille : les sources alimentent Feedly, qui nourrit les fiches d'analyse">
  <path class="line" d="M180 35 H300" /><path class="dash" d="M180 35 H300" />
  <path class="line" d="M500 35 H620" /><path class="dash" d="M500 35 H620" />
  <path d="M293 30 l7 5 -7 5" fill="none" stroke="var(--accent-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M613 30 l7 5 -7 5" fill="none" stroke="var(--accent-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  {boxes.map(b => (
    <g>
      <rect class:list={['box', { 'box--accent': b.accent }]} x={b.x} y="12" width={b.w} height="46" rx="8" />
      <text class="strong" x={b.x + b.w / 2} y="32" text-anchor="middle">{b.l1}</text>
      <text x={b.x + b.w / 2} y="48" text-anchor="middle">{b.l2}</text>
    </g>
  ))}
</svg>
