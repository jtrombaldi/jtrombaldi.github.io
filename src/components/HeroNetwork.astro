---
// Fond animé du hero (brief §7 : « réseau, flux qui s'initialise » — sobre).
// Nœuds + arêtes statiques, quelques paquets qui circulent le long des arêtes.
// Décoratif : aria-hidden, pointer-events none, coupé par l'interrupteur global.
const nodes = [
  { x: 560, y: 60 }, { x: 660, y: 130 }, { x: 740, y: 70 }, { x: 620, y: 220 },
  { x: 720, y: 190 }, { x: 780, y: 260 }, { x: 500, y: 160 }, { x: 690, y: 290 },
];
const core = 1; // nœud central
const edges: [number, number][] = [[0,1],[1,2],[1,3],[1,4],[4,5],[6,1],[3,7],[4,2],[6,0],[5,7]];
const path = ([a, b]: [number, number]) => `M${nodes[a].x} ${nodes[a].y} L${nodes[b].x} ${nodes[b].y}`;
const packets = [
  { e: 0, dur: 4.5, delay: 0 }, { e: 3, dur: 5.2, delay: -1.8 }, { e: 4, dur: 4, delay: -3 },
  { e: 5, dur: 6, delay: -0.9 }, { e: 6, dur: 5.5, delay: -4.2 }, { e: 8, dur: 4.8, delay: -2.4 },
];
---
<svg class="hero__net" viewBox="0 0 820 320" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="hero-fade" cx="85%" cy="40%" r="70%">
      <stop offset="0" stop-color="#fff" stop-opacity="1" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="hero-mask"><rect width="820" height="320" fill="url(#hero-fade)" /></mask>
  </defs>
  <g mask="url(#hero-mask)">
    {edges.map(e => <path class="edge" d={path(e)} fill="none" />)}
    {packets.map(p => (
      <circle class="pkt" r="2.5" style={`offset-path: path("${path(edges[p.e])}"); --pkt-dur: ${p.dur}s; --pkt-delay: ${p.delay}s`} />
    ))}
    {nodes.map((n, i) => (
      <circle class:list={['node', { 'node--core': i === core }]} cx={n.x} cy={n.y} r={i === core ? 4 : 2.5} style={`--i: ${i}`} />
    ))}
  </g>
</svg>
