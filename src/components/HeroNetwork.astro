---
// Fond animé du hero (brief §7 : « réseau, flux qui s'initialise »).
// Nœuds avec halo, arêtes, paquets qui circulent (CSS offset-path) ; parallaxe souris via GSAP.
const nodes = [
  { x: 520, y: 70 }, { x: 640, y: 140 }, { x: 750, y: 60 }, { x: 600, y: 240 }, { x: 720, y: 200 },
  { x: 790, y: 280 }, { x: 470, y: 170 }, { x: 680, y: 300 }, { x: 560, y: 300 }, { x: 800, y: 140 },
  { x: 430, y: 260 }, { x: 700, y: 20 },
];
const core = 1;
const edges: [number, number][] = [[0,1],[1,2],[1,3],[1,4],[4,5],[6,1],[3,7],[4,2],[6,0],[5,7],[3,8],[8,10],[6,10],[4,9],[9,2],[2,11],[0,11]];
const path = ([a, b]: [number, number]) => `M${nodes[a].x} ${nodes[a].y} L${nodes[b].x} ${nodes[b].y}`;
const packets = [
  { e: 0, dur: 4.5, delay: 0 }, { e: 3, dur: 5.2, delay: -1.8 }, { e: 4, dur: 4, delay: -3 }, { e: 5, dur: 6, delay: -0.9 },
  { e: 6, dur: 5.5, delay: -4.2 }, { e: 8, dur: 4.8, delay: -2.4 }, { e: 11, dur: 5, delay: -1.2 }, { e: 13, dur: 4.2, delay: -3.6 },
  { e: 15, dur: 5.8, delay: -0.4 }, { e: 2, dur: 4.6, delay: -2.9 },
];
const glows = [1, 4, 6, 2];
---
<svg class="hero__net" viewBox="0 0 820 320" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="hero-fade" cx="82%" cy="45%" r="75%">
      <stop offset="0" stop-color="#fff" stop-opacity="1" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="hero-mask"><rect width="820" height="320" fill="url(#hero-fade)" /></mask>
    <filter id="hero-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="4" /></filter>
  </defs>
  <g mask="url(#hero-mask)"><g class="layer">
    {edges.map(e => <path class="edge" d={path(e)} fill="none" />)}
    {glows.map(i => <circle class="glow" cx={nodes[i].x} cy={nodes[i].y} r="9" filter="url(#hero-glow)" />)}
    {packets.map(p => (
      <g class="pkt-g">
        <circle class="pkt pkt--trail" r="2" style={`offset-path: path("${path(edges[p.e])}"); --pkt-dur: ${p.dur}s; --pkt-delay: ${p.delay - 0.12}s`} />
        <circle class="pkt" r="2.6" style={`offset-path: path("${path(edges[p.e])}"); --pkt-dur: ${p.dur}s; --pkt-delay: ${p.delay}s`} />
      </g>
    ))}
    {nodes.map((n, i) => (
      <circle class:list={['node', { 'node--core': i === core }]} cx={n.x} cy={n.y} r={i === core ? 4.5 : 2.6} style={`--i: ${i}`} />
    ))}
  </g></g>
</svg>
